%% test_if_or.lexor
SCRIPT AREA
START SCRIPT
    DECLARE INT num = -5
    DECLARE BOOL result

    %% IF with OR condition
    IF (num < 0 OR num == 0)
        START IF
            PRINT: "Number is zero or negative" & $ & [[] & num & []]
        END IF
    ELSE
        START IF
            PRINT: "Number is positive" & $ & [[] & num & []]
        END IF

END SCRIPT